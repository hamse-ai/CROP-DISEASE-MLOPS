# ---- Dataset ----------------------------------------------------------------
# The full PlantVillage dataset (~1.5 GB, 54,303 images) is NOT committed.
# Fetch it with:  python src/acquire_data.py
# A small sample (5 images per class) IS committed so the repo runs out of the box
# -- the negations below keep that sample tracked.
data/train/**
data/test/**
!data/train/**/
!data/test/**/
!data/**/.gitkeep
!data/**/SAMPLE_*.jpg
!data/**/SAMPLE_*.JPG
!data/**/SAMPLE_*.png
!data/**/SAMPLE_*.PNG

# Raw download staging + user uploads awaiting retraining
data/raw/
data/uploads/*
!data/uploads/.gitkeep
data/PlantVillage-Dataset/

# ---- Model artifacts --------------------------------------------------------
# Everything the container needs at runtime IS committed. Render builds the
# image from this repository, so anything excluded here is simply absent in
# production -- the replay buffer especially, without which retraining refuses
# to run at all.
#
# Committed (~40 MB total):
#   backbone_mobilenetv2.onnx   frozen feature extractor
#   head_v1.pkl                 the shipped classifier
#   train_embeddings.npz        replay buffer, needed to retrain
#   eval_embeddings.npz         held-out set, needed to score a retrain
#   class_names.json, registry.json
#
# Excluded: the full per-split embedding cache (~240 MB), which is a rebuildable
# intermediate produced by `python src/train_export.py --embed`.
models/embeddings/
models/checkpoints/

# Heads produced by retraining at runtime; v1 ships with the repo.
models/head_v*.pkl
!models/head_v1.pkl
*.h5
*.keras
saved_model/

# ---- Runtime state ----------------------------------------------------------
reports/load_test/*.csv
!reports/load_test/.gitkeep
logs/
*.log
monitoring_state.json
prediction_log.jsonl

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
env/
venv/
.venv/

# ---- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
